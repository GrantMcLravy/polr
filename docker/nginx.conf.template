# nginx for Polr in front of the app container's PHP-FPM.
# ${POLR_FPM_ADDRESS} is filled in from the environment (default polr:9000).
server {
    listen 80;
    server_name _;
    root /var/www/html/public;
    index index.php;
    server_tokens off;
    # Relative redirects: nginx does not know the external host/port.
    absolute_redirect off;

    # Never serve dotfiles (.env, .htaccess, .git, ...).
    location ~ /\.(?!well-known/) {
        deny all;
    }

    # Remove trailing slashes, as public/.htaccess does for Apache. (At server
    # level: an "if" inside a location would bypass that location's try_files.)
    if (!-d $request_filename) {
        rewrite ^/(.+)/$ /$1 permanent;
    }

    location / {
        try_files $uri /index.php?$query_string;
    }

    # Only the front controller is executed.
    location = /index.php {
        include fastcgi_params;
        fastcgi_pass ${POLR_FPM_ADDRESS};
        fastcgi_param SCRIPT_FILENAME /var/www/html/public/index.php;
        fastcgi_param DOCUMENT_ROOT /var/www/html/public;
        fastcgi_hide_header X-Powered-By;
    }

    location ~ \.php$ {
        return 404;
    }
}
