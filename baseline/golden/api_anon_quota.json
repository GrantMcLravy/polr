{
  "group": "api_anon_quota",
  "env": {
    "SETTING_ANON_API_QUOTA": "2"
  },
  "steps": [
    {
      "name": "anonymous call 0",
      "request": {
        "method": "GET",
        "path": "/api/v2/action/shorten",
        "params": {
          "url": "https://example.com/anon-q-0",
          "response_type": "json"
        },
        "data": null,
        "headers": null
      },
      "response": {
        "status": 200,
        "headers": [
          [
            "Cache-Control",
            "no-cache"
          ],
          [
            "Access-Control-Allow-Origin",
            "*"
          ],
          [
            "Set-Cookie",
            "laravel_session=<MASKED>; expires=<MASKED>; Max-Age=<MASKED>; path=/; HttpOnly"
          ],
          [
            "Content-Type",
            "application/json"
          ]
        ],
        "json": {
          "action": "shorten",
          "result": "http://polr.test/d"
        },
        "body": null
      }
    },
