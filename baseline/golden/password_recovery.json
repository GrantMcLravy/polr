\n            <span class=\"icon-bar\"></span>\n        </button>\n\n        <!-- Output sign in/sign out buttons appropriately -->\n        <div class=\"navbar-header\">\n            <a class=\"navbar-brand\" href=\"<BASE>\">Polr Baseline</a>\n        </div>\n\n        <ul id=\"navbar\" class=\"nav navbar-collapse collapse navbar-nav\" id=\"nbc\">\n\t\t    <li><a href=\"<BASE>/about-polr\">About</a></li>\n\n                            <li class=\"visible-xs\"><a href=\"<BASE>/login\">Sign In</a></li>\n                                    <li class=\"visible-xs\"><a href=\"<BASE>/signup\">Sign Up</a></li>\n                                    </ul>\n\n        <ul id=\"navbar\" class=\"nav pull-right navbar-nav hidden-xs\">\n            <li class=\"divider-vertical\"></li>\n\n                                                <li><a href=\"<BASE>/signup\">Sign Up</a></li>\n                \n                <li class=\"dropdown\">\n                    <a class=\"dropdown-toggle\" href=\"#\" data-toggle=\"dropdown\">Sign In <strong class=\"caret\"></strong></a>\n                    <div class=\"dropdown-menu pull-right login-dropdown-menu\" id=\"dropdown\">\n                        <h2>Login</h2>\n                        <form action=\"login\" method=\"POST\" accept-charset=\"UTF-8\">\n                            <input type=\"text\" name=\"username\" placeholder='Username' size=\"30\" class=\"form-control login-form-field\" />\n                            <input type=\"password\" name=\"password\" placeholder='Password' size=\"30\" class=\"form-control login-form-field\" />\n                            <input type=\"hidden\" name='_token' value='<CSRF>' />\n                            <input class=\"btn btn-success form-control login-form-submit\" type=\"submit\" name=\"login\" value=\"Sign In\" />\n                        </form>\n                    </div>\n                </li>\n                    </ul>\n    </nav>\n</div>\n    <div class=\"container\">\n        <div class=\"content-div  content-div-padding  \">\n            <h1 class='header'>Reset Password</h1>\n\n<div class='col-md-6 col-md-offset-3'>\n    <form action=\"#\" method='POST'>\n        <input type='password' id='passwordFirst' placeholder='New Password' class='form-control password-input-pd'>\n        <input type='password' id='passwordConfirm' placeholder='Confirm New Password' class='form-control password-input-pd' name='new_password'>\n\n        <input type=\"hidden\" name='_token' value='<CSRF>' />\n        <input type='submit' id='submitForm' value='Reset Password' class='form-control'>\n    </form>\n</div>\n        </div>\n    </div>\n\n        <script src=\"/js/constants.js\"></script>\n    <script src=\"/js/jquery-1.11.3.min.js\"></script>\n    <script src=\"/js/bootstrap.min.js\"></script>\n    <script src=\"/js/angular.min.js\"></script>\n    <script src=\"/js/toastr.min.js\"></script>\n    <script src=\"/js/base.js\"></script>\n\n    <script>\n                \n        </script>\n\n    <script src='/js/reset_password.js'></script>\n</body>\n</html>\n"
